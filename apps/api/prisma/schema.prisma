generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PointStatut {
  GRIS
  ORANGE
  VERT
}

enum PlanFileType {
  PDF
  PNG
  JPG
  SVG
}

enum UserRole {
  ADMIN
  TECHNICIEN
}

// "Dossier chantier" lifecycle — broader than the old implicit
// open/closed state. CLOTURE is a distinct terminal step after TERMINE
// (closing produces a recap and the dossier stays read-only/consultable).
enum ChantierStatut {
  PREPARATION
  PRET
  EN_COURS
  BLOQUE
  TERMINE
  CLOTURE
}

enum BlocageStatut {
  OUVERT
  RESOLU
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  chantiers  Chantier[]
  termValues TermValue[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(ADMIN)
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  chantiers            Chantier[]           @relation("ChantierCreatedBy")
  chantiersResponsable Chantier[]           @relation("ChantierResponsable")
  reports              Report[]
  chantierAssignments  ChantierAssignment[]
  documentsUploaded    Document[]
  blocagesAuthored     Blocage[]
  activityLogs         ActivityLog[]
}

model Chantier {
  id             String       @id @default(cuid())
  // Human-readable identifier, unique per organization (e.g. "CH-0001") —
  // distinct from the internal cuid `id`. Generated by Field at creation.
  reference      String
  name           String
  description    String?
  address        String?
  client         String?
  entrepriseExecutante String?
  dateDebutPrevue DateTime?
  dateFinPrevue   DateTime?
  statut         ChantierStatut @default(PREPARATION)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User         @relation("ChantierCreatedBy", fields: [createdById], references: [id])
  responsableId  String?
  responsable    User?        @relation("ChantierResponsable", fields: [responsableId], references: [id])
  plans          Plan[]
  documents      Document[]
  materiels      Materiel[]
  reports        Report[]
  assignments    ChantierAssignment[]
  activityLogs   ActivityLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, reference])
}

// Which technicians can access a given chantier. Only meaningful for
// TECHNICIEN users — ADMINs see every chantier in their organization
// regardless of assignment.
model ChantierAssignment {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([chantierId, userId])
}

model Plan {
  id          String       @id @default(cuid())
  chantierId  String
  chantier    Chantier     @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  fileType    PlanFileType
  width       Int?
  height      Int?
  reference   String?
  description String?
  version     String?
  statut      String?
  points      Point[]
  uploadedAt  DateTime     @default(now())
}

model Point {
  id          String      @id @default(cuid())
  planId      String
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  identifiant String
  nom         String?
  type        String?
  commentaire String?
  statut      PointStatut @default(GRIS)
  x           Float
  y           Float
  photos      Photo[]
  blocages    Blocage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Photo {
  id          String   @id @default(cuid())
  pointId     String
  point       Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)
  // Optional tag linking a photo to a specific blockage/anomaly, without
  // changing its primary point relationship — a photo is still always
  // attached to its point first.
  blocageId   String?
  blocage     Blocage? @relation(fields: [blocageId], references: [id], onDelete: SetNull)
  filePath    String
  takenAt     DateTime
  gpsLat      Float?
  gpsLng      Float?
  gpsAccuracy Float?
  createdAt   DateTime @default(now())
}

// Generic document library for a chantier — distinct from Plan (which the
// terrain viewer/points system uses). `category` is free text (Plans,
// Documents techniques, Documents administratifs, Sécurité, Autres, or
// anything the company adds) rather than a fixed enum, same philosophy as
// Point.type.
model Document {
  id             String   @id @default(cuid())
  chantierId     String
  chantier       Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  category       String
  name           String
  version        String?
  date           DateTime?
  author         String?
  commentaire    String?
  fileName       String
  filePath       String
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())
}

model Materiel {
  id                String   @id @default(cuid())
  chantierId        String
  chantier          Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  designation       String
  reference         String?
  quantitePrevue    Float?
  quantiteUtilisee  Float?
  unite             String?
  commentaire       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Blocage {
  id          String        @id @default(cuid())
  pointId     String
  point       Point         @relation(fields: [pointId], references: [id], onDelete: Cascade)
  categorie   String?
  description String?
  commentaire String?
  statut      BlocageStatut @default(OUVERT)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  photos      Photo[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Automatic audit trail for a dossier — never hand-filled by a technician.
// Written by the backend whenever a tracked action happens (wiring the
// actual log-writing calls into each route is left to the phase that
// ships the Historique screen, so logging and its UI land together).
model ActivityLog {
  id          String   @id @default(cuid())
  chantierId  String
  chantier    Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  description String?
  createdAt   DateTime @default(now())

  @@index([chantierId, createdAt])
}

// Generic, business-agnostic autocomplete library: every text field in the
// app (point type, comment, chantier name, ...) records the values users
// actually type, namespaced by `field` (e.g. "point.type"), so suggestions
// stay relevant per field without any hardcoded domain vocabulary. Scoped
// per organization so different companies never see each other's terms.
model TermValue {
  id             String       @id @default(cuid())
  field          String
  value          String
  useCount       Int          @default(1)
  lastUsedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, field, value])
  @@index([organizationId, field])
}

model Report {
  id            String   @id @default(cuid())
  chantierId    String
  chantier      Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  filePath      String
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())
}
