generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PointStatut {
  GRIS
  ORANGE
  VERT
}

enum PlanFileType {
  PDF
  PNG
  JPG
  SVG
}

enum UserRole {
  ADMIN
  TECHNICIEN
}

// "Dossier chantier" lifecycle — broader than the old implicit
// open/closed state. CLOTURE is a distinct terminal step after TERMINE
// (closing produces a recap and the dossier stays read-only/consultable).
enum ChantierStatut {
  PREPARATION
  PRET
  EN_COURS
  BLOQUE
  TERMINE
  CLOTURE
}

enum BlocageStatut {
  OUVERT
  RESOLU
}

enum BlocagePriorite {
  FAIBLE
  NORMALE
  HAUTE
}

enum BlocagePhotoRole {
  DEPART
  BLOCAGE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  legalName String?
  logoPath String?
  address String?
  postalCode String?
  city String?
  country String?
  phone String?
  contactEmail String?
  notificationEmail String?
  responsibleName String?
  website String?
  timezone String @default("Europe/Paris")
  locale String @default("fr-FR")
  notificationPreferences Json @default("{}")

  users        User[]
  chantiers    Chantier[]
  termValues   TermValue[]
  blocages     Blocage[]
  activityLogs ActivityLog[]
  materiels    Materiel[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(ADMIN)
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  inviteTokenHash String?     @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime?
  invitationAcceptedAt DateTime?
  deletedAt DateTime?
  phone String?
  employerCompany String?

  chantiers            Chantier[]           @relation("ChantierCreatedBy")
  chantiersResponsable Chantier[]           @relation("ChantierResponsable")
  reports              Report[]
  chantierAssignments  ChantierAssignment[]
  documentsUploaded    Document[]
  blocagesCreated      Blocage[]            @relation("BlocageCreatedBy")
  blocagesResolved     Blocage[]            @relation("BlocageResolvedBy")
  activityLogs         ActivityLog[]
  pushSubscriptions    PushSubscription[]
  materielsCreated     Materiel[]           @relation("MaterielCreatedBy")
  materielsUpdated     Materiel[]           @relation("MaterielUpdatedBy")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Chantier {
  id             String       @id @default(cuid())
  // Human-readable identifier, unique per organization (e.g. "CH-0001") —
  // distinct from the internal cuid `id`. Generated by Field at creation.
  reference      String
  name           String
  description    String?
  address        String?
  client         String?
  entrepriseExecutante String?
  dateDebutPrevue DateTime?
  dateFinPrevue   DateTime?
  statut         ChantierStatut @default(PREPARATION)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User         @relation("ChantierCreatedBy", fields: [createdById], references: [id])
  responsableId  String?
  responsable    User?        @relation("ChantierResponsable", fields: [responsableId], references: [id])
  plans          Plan[]
  documents      Document[]
  materiels      Materiel[]
  reports        Report[]
  assignments    ChantierAssignment[]
  activityLogs   ActivityLog[]
  blocages       Blocage[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, reference])
}

// Which technicians can access a given chantier. Only meaningful for
// TECHNICIEN users — ADMINs see every chantier in their organization
// regardless of assignment.
model ChantierAssignment {
  id         String    @id @default(cuid())
  chantierId String
  chantier   Chantier  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  // Null until the assigned technician opens the chantier for the first
  // time — drives the "Nouveau" badge in their chantier list. No email/push,
  // just an in-app signal seen on next app open.
  seenAt     DateTime?

  @@unique([chantierId, userId])
}

model Plan {
  id          String       @id @default(cuid())
  chantierId  String
  chantier    Chantier     @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  fileType    PlanFileType
  width       Int?
  height      Int?
  reference   String?
  description String?
  version     String?
  statut      String?
  points      Point[]
  uploadedAt  DateTime     @default(now())
}

model Point {
  id          String      @id @default(cuid())
  planId      String
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  identifiant String
  nom         String?
  type        String?
  commentaire String?
  statut      PointStatut @default(GRIS)
  x           Float
  y           Float
  photos      Photo[]
  blocages    Blocage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Photo {
  id          String   @id @default(cuid())
  pointId     String
  point       Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)
  // Optional tag linking a photo to a specific blockage/anomaly, without
  // changing its primary point relationship — a photo is still always
  // attached to its point first.
  blocageId   String?
  blocage     Blocage? @relation(fields: [blocageId], references: [id], onDelete: SetNull)
  blocageRole BlocagePhotoRole?
  filePath    String
  takenAt     DateTime
  gpsLat      Float?
  gpsLng      Float?
  gpsAccuracy Float?
  createdAt   DateTime @default(now())
}

// Generic document library for a chantier — distinct from Plan (which the
// terrain viewer/points system uses). `category` is free text (Plans,
// Documents techniques, Documents administratifs, Sécurité, Autres, or
// anything the company adds) rather than a fixed enum, same philosophy as
// Point.type.
model Document {
  id             String   @id @default(cuid())
  chantierId     String
  chantier       Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  category       String
  name           String
  version        String?
  date           DateTime?
  author         String?
  commentaire    String?
  fileName       String
  filePath       String
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())
}

// "What was planned for this chantier, and what was actually used?" —
// deliberately not a stock/inventory system: no warehouse, no reservations,
// no suppliers, no pricing. See modules/materiel/routes.ts.
model Materiel {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  chantierId       String
  chantier         Chantier     @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  reference        String?
  designation      String
  quantitePrevue   Float?
  quantiteUtilisee Float?
  unite            String?
  commentaire      String?
  createdById      String
  createdBy        User         @relation("MaterielCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        User?        @relation("MaterielUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([chantierId])
  @@index([organizationId])
}

model Blocage {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  chantierId     String
  chantier       Chantier         @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  pointId        String
  point          Point            @relation(fields: [pointId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User             @relation("BlocageCreatedBy", fields: [createdById], references: [id])
  titre          String
  description    String
  statut         BlocageStatut    @default(OUVERT)
  priorite       BlocagePriorite  @default(NORMALE)
  startX          Float?
  startY          Float?
  endX            Float?
  endY            Float?
  startGpsLat     Float?
  startGpsLng     Float?
  startGpsAccuracy Float?
  endGpsLat       Float?
  endGpsLng       Float?
  endGpsAccuracy  Float?
  distanceMeters Float?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?            @relation("BlocageResolvedBy", fields: [resolvedById], references: [id])
  photos         Photo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, statut])
  @@index([chantierId, statut])
  @@index([pointId, statut])
}

// Automatic audit trail for a dossier — never hand-filled by a technician.
// Written exclusively through activity/service.ts#logActivity, which
// allowlists what each action type is allowed to put in `metadata` so no
// module can leak an incompatible or sensitive shape into this table.
model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  chantierId     String
  chantier       Chantier     @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  action         String
  description    String?
  // Small, display-oriented key/value bag (point/plan/document ids and
  // names, previous/new statut, ...) — never secrets or raw file content.
  // Shape is enforced per-action by logActivity's allowlist, not by Prisma.
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([chantierId, createdAt])
  @@index([organizationId, createdAt])
}

// Generic, business-agnostic autocomplete library: every text field in the
// app (point type, comment, chantier name, ...) records the values users
// actually type, namespaced by `field` (e.g. "point.type"), so suggestions
// stay relevant per field without any hardcoded domain vocabulary. Scoped
// per organization so different companies never see each other's terms.
model TermValue {
  id             String       @id @default(cuid())
  field          String
  value          String
  useCount       Int          @default(1)
  lastUsedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, field, value])
  @@index([organizationId, field])
}

model Report {
  id            String   @id @default(cuid())
  chantierId    String
  chantier      Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  filePath      String
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())
}
