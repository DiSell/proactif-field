# Copy this file to apps/api/.env.test (gitignored) to run `npm run test --workspace=apps/api`.
#
# DATABASE_URL_TEST MUST point to a database dedicated to tests — never the
# production/dev database from apps/api/.env. Tests create and delete rows
# freely; globalSetup.ts refuses to start if this is missing or equals the
# real DATABASE_URL.
#
# Acceptable options:
#   - a local Postgres instance (e.g. postgresql://postgres:postgres@localhost:5432/proactif_field_test)
#   - a separate Neon project/branch created only for CI/tests
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/proactif_field_test"
# Only needed if your test database also requires a distinct direct
# (non-pooled) connection string for `prisma migrate deploy`. Defaults to
# DATABASE_URL_TEST when unset.
DIRECT_URL_TEST=""

# The test process does not read apps/api/.env, so anything else the app
# needs at boot (env.ts's `required(...)` checks) must also live here.
JWT_SECRET="test-only-secret-do-not-use-in-production"
PORT=4100
UPLOAD_DIR="uploads-test"
CORS_ORIGIN="http://localhost:5173"
